+bool SameDcrtParameters(const lbcrypto::DCRTPoly& element,
+                        const std::shared_ptr<lbcrypto::DCRTPoly::Params>& expected) {
+    if (!expected) {
+        return false;
+    }
+    const auto& towers = element.GetAllElements();
+    const auto& params = expected->GetParams();
+    if (towers.size() != params.size()) {
+        return false;
+    }
+    for (std::size_t index = 0; index < towers.size(); ++index) {
+        if (!params[index] || towers[index].GetModulus() != params[index]->GetModulus() ||
+            towers[index].GetRootOfUnity() != params[index]->GetRootOfUnity() ||
+            towers[index].GetCyclotomicOrder() != params[index]->GetCyclotomicOrder()) {
+            return false;
+        }
+    }
+    return true;
+}
