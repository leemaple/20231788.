+CiphertextPair DoubleCKKS::Relin2(const TensorCiphertextPair& tensor) const {
+    ValidateTensorResult(tensor);
+    if (tensor.orderedModuli_.size() < tensor.noiseScaleDegree_) {
+        Invalid("Relin2 requires at least as many active Q_l towers as the Tensor noise-scale degree");
+    }
+    ValidateRelin2EvaluationKey(tensor.keyTag_);
+
+    auto raisedHigh = tensor.high_->Clone();
+    auto raisedElements = raisedHigh->GetElements();
+    const auto& fullTowerParameters = parameters_->GetElementParams()->GetParams();
+    for (auto& element : raisedElements) {
+        auto towers = element.GetAllElements();
+        for (auto& tower : towers) {
+            tower *= divisor_;
+        }
+        lbcrypto::NativePoly zeroTower(fullTowerParameters.back(), Format::EVALUATION, true);
+        towers.push_back(std::move(zeroTower));
+        element = lbcrypto::DCRTPoly(towers);
+    }
+    raisedHigh->SetElements(std::move(raisedElements));
+    raisedHigh->SetLevel(0);
+    ValidateCiphertext(raisedHigh, fullModuli_, 0, 3, tensor.recordedScalingFactor_, tensor.keyTag_, tensor.slots_, 3,
+                       "Relin2 raised-high", "Relin2 raised high");
+
+    lbcrypto::ConstCiphertext<lbcrypto::DCRTPoly> raisedHighConst = raisedHigh;
+    auto relinearizedHigh = context_->Relinearize(raisedHighConst);
+    lbcrypto::ConstCiphertext<lbcrypto::DCRTPoly> lowConst = tensor.low_;
+    auto relinearizedLow = context_->Relinearize(lowConst);
+
+    ValidateCiphertext(relinearizedHigh, fullModuli_, 0, 3, tensor.recordedScalingFactor_, tensor.keyTag_, tensor.slots_,
+                       2, "Relin2 relinearized-high", "Relin2 relinearized high");
+    auto decomposed = DecomposeValidatedFullBasis(relinearizedHigh);
+
+    ValidateCiphertext(decomposed.second, firstPairModuli_, 1, 3, tensor.recordedScalingFactor_, tensor.keyTag_,
+                       tensor.slots_, 2, "Relin2 DCP remainder", "Relin2 DCP remainder");
+    ValidateCiphertext(relinearizedLow, firstPairModuli_, 1, 3, tensor.recordedScalingFactor_, tensor.keyTag_,
+                       tensor.slots_, 2, "Relin2 relinearized-low", "Relin2 relinearized low");
+    if (decomposed.second->GetCryptoContext().get() != relinearizedLow->GetCryptoContext().get() ||
+        decomposed.second->GetKeyTag() != relinearizedLow->GetKeyTag() ||
+        decomposed.second->GetSlots() != relinearizedLow->GetSlots() ||
+        decomposed.second->GetEncodingType() != relinearizedLow->GetEncodingType() ||
+        decomposed.second->GetLevel() != relinearizedLow->GetLevel() ||
+        decomposed.second->GetNoiseScaleDeg() != relinearizedLow->GetNoiseScaleDeg() ||
+        decomposed.second->GetScalingFactor() != relinearizedLow->GetScalingFactor()) {
+        Invalid("Relin2 pre-add ciphertext metadata mismatch");
+    }
+
+    lbcrypto::ConstCiphertext<lbcrypto::DCRTPoly> remainderConst = decomposed.second;
+    lbcrypto::ConstCiphertext<lbcrypto::DCRTPoly> relinearizedLowConst = relinearizedLow;
+    auto outputLow = context_->EvalAdd(remainderConst, relinearizedLowConst);
+
+    PaperScaleDescriptor paperScale{tensor.recordedScalingFactor_, divisor_,
+                                    tensor.tensorScale_.approximateHighLogicalScalingFactor,
+                                    tensor.tensorScale_.approximateRecombinedLogicalScalingFactor};
+    CiphertextPair result(std::move(decomposed.first), std::move(outputLow), context_.get(), divisor_, firstPairModuli_,
+                          1, paperScale, tensor.recordedScalingFactor_, 3, PairLifecycle::ReadyForRS2, tensor.keyTag_,
+                          tensor.slots_, Format::EVALUATION, 2);
+    ValidatePair(result);
+    return result;
 }
 
