+void DoubleCKKS::ValidateRelin2EvaluationKey(const std::string& keyTag) const {
+    auto& allKeys = lbcrypto::CryptoContextImpl<lbcrypto::DCRTPoly>::GetAllEvalMultKeys();
+    const auto found = allKeys.find(keyTag);
+    if (found == allKeys.end()) {
+        Invalid("Relin2 evaluation key is missing for the Tensor key tag");
+    }
+    const auto& keys = found->second;
+    if (keys.empty()) {
+        Invalid("Relin2 evaluation-key vector is empty");
+    }
+    const auto& key = keys.front();
+    if (!key) {
+        Invalid("Relin2 first evaluation key is null");
+    }
+    if (key->GetCryptoContext().get() != context_.get()) {
+        Invalid("Relin2 first evaluation key belongs to a different context");
+    }
+    if (key->GetKeyTag() != keyTag) {
+        Invalid("Relin2 first evaluation key tag does not match the Tensor key tag");
+    }
+    const auto relinKey = std::dynamic_pointer_cast<lbcrypto::EvalKeyRelinImpl<lbcrypto::DCRTPoly>>(key);
+    if (!relinKey) {
+        Invalid("Relin2 first evaluation key has the wrong concrete subtype");
+    }
+
+    const auto& a = relinKey->GetAVector();
+    const auto& b = relinKey->GetBVector();
+    const auto technique = parameters_->GetKeySwitchTechnique();
+    std::size_t expectedCount = 0;
+    std::shared_ptr<lbcrypto::DCRTPoly::Params> expectedParams;
+    const char* techniqueLabel = nullptr;
+    if (technique == lbcrypto::HYBRID) {
+        expectedCount = parameters_->GetNumPartQ();
+        expectedParams = parameters_->GetParamsQP();
+        techniqueLabel = "HYBRID";
+    }
+    else if (technique == lbcrypto::BV) {
+        const auto digitSize = parameters_->GetDigitSize();
+        if (digitSize == 0) {
+            expectedCount = fullModuli_.size();
+        }
+        else {
+            const auto& qParams = parameters_->GetElementParams()->GetParams();
+            for (const auto& qParam : qParams) {
+                expectedCount += (qParam->GetModulus().GetMSB() + digitSize - 1) / digitSize;
+            }
+        }
+        expectedParams = parameters_->GetElementParams();
+        techniqueLabel = "BV";
+    }
+    else {
+        Invalid("Relin2 key-switch technique is unsupported");
+    }
+
+    if (a.size() != expectedCount) {
+        Invalid(std::string("Relin2 evaluation key ") + techniqueLabel + " A vector length mismatch");
+    }
+    if (b.size() != expectedCount) {
+        Invalid(std::string("Relin2 evaluation key ") + techniqueLabel + " B vector length mismatch");
+    }
+    for (std::size_t index = 0; index < expectedCount; ++index) {
+        if (a[index].GetFormat() != Format::EVALUATION || b[index].GetFormat() != Format::EVALUATION) {
+            Invalid(std::string("Relin2 evaluation key ") + techniqueLabel + " entry must be in evaluation format");
+        }
+        if (!SameDcrtParameters(a[index], expectedParams) || !SameDcrtParameters(b[index], expectedParams)) {
+            Invalid(std::string("Relin2 evaluation key ") + techniqueLabel + " entry basis mismatch");
+        }
+    }
+}
