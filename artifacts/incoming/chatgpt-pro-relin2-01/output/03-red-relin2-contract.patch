+void TestDeterministicDcpBoundaryWitnesses() {
+    EvalKeyMapGuard guard;
+    auto fixture=MakeTensorFixtureFor(MakeRelinContext(lbcrypto::BV,0)); DoubleCKKS module(fixture.context);
+    auto [left,right]=MakePairs(fixture,module); auto tensor=module.Tensor2(left,right);
+    const BigInt divisor(tensor.GetDivisor().ConvertToInt()); const BigInt half=divisor/2;
+    auto mutableHigh=std::const_pointer_cast<lbcrypto::CiphertextImpl<DCRTPoly>>(tensor.GetHigh());
+    auto elements=mutableHigh->GetElements(); auto c2=ToCoefficient(elements.at(2)); auto& towers=c2.GetAllElements();
+    for (auto& tower:towers) { lbcrypto::NativeVector zeros(tower.GetLength(),tower.GetModulus()); tower.SetValues(std::move(zeros),Format::COEFFICIENT); }
+    const BigInt q0(towers.at(0).GetModulus().ConvertToInt()); const BigInt inv=ModInverse(divisor,q0);
+    const std::vector<BigInt> targets={half,half+1,1};
+    auto vals=towers.at(0).GetValues();
+    for(std::size_t i=0;i<targets.size();++i) vals[i]=NativeInteger(PositiveMod(targets[i]*inv,q0).convert_to<std::uint64_t>());
+    towers.at(0).SetValues(std::move(vals),Format::COEFFICIENT); c2.SetFormat(Format::EVALUATION); elements.at(2)=std::move(c2); mutableHigh->SetElements(std::move(elements));
+
+    const auto params=std::dynamic_pointer_cast<lbcrypto::CryptoParametersCKKSRNS>(fixture.context->GetCryptoParameters());
+    const std::size_t count=params->GetElementParams()->GetParams().size();
+    std::vector<DCRTPoly> a(count,DCRTPoly(params->GetElementParams(),Format::EVALUATION,true));
+    std::vector<DCRTPoly> b(count,DCRTPoly(params->GetElementParams(),Format::EVALUATION,true));
+    const std::size_t n=params->GetElementParams()->GetRingDimension(); std::vector<BigInt> one(n,0); one[0]=1; b[0]=MakePolynomial(params->GetElementParams(),one);
+    auto key=std::make_shared<lbcrypto::EvalKeyRelinImpl<DCRTPoly>>(fixture.context); key->SetKeyTag(tensor.GetKeyTag()); key->SetAVector(a); key->SetBVector(b);
+    auto& map=lbcrypto::CryptoContextImpl<DCRTPoly>::GetAllEvalMultKeys(); map[tensor.GetKeyTag()]={key};
+    auto raised=RaiseHighReference(tensor,fixture.context); lbcrypto::ConstCiphertext<DCRTPoly> rc=raised; auto relin=fixture.context->Relinearize(rc);
+    const BigInt s0=ReconstructCoefficient(relin->GetElements().at(0),0); const auto d0=DecomposeCentered(s0,divisor);
+    const BigInt s1=ReconstructCoefficient(relin->GetElements().at(0),1); const auto d1=DecomposeCentered(s1,divisor);
+    Check(d0.second==half,"deterministic positive centered-remainder boundary missing at component=0,coefficient=0");
+    Check(d1.second==-half,"deterministic negative centered-remainder boundary missing at component=0,coefficient=1");
+    const BigInt positiveResidue=half+1; const BigInt baseQuotient=(s1-positiveResidue)/divisor;
+    Check(d1.first==baseQuotient+1,"deterministic quotient-carry witness missing at component=0,coefficient=1");
+    std::cout << "Relin2 deterministic DCP witnesses: positive=(0,0), negative/carry=(0,1)\n";
+    (void)module.Relin2(tensor);
+}
+using TestFunction = void (*)();
+
+TestFunction ResolveTest(const std::string& name) {
+    // Keep the accepted Tensor2 functions referenced in this copied public-seam
+    // harness so strict -Wunused-function remains warning-clean. They are not
+    // registered as Relin2 CTests; the original tensor2_test target remains the
+    // regression authority for these cases.
+    if (name == "legacy_valid_arithmetic") return &TestValidArithmeticAndImmutability;
+    if (name == "legacy_result_scale") return &TestResultAndScaleContract;
+    if (name == "legacy_right_validation") return &TestRightInputValidation;
+    if (name == "legacy_mutual_compatibility") return &TestMutualCompatibility;
+    if (name == "legacy_key_compatibility") return &TestPreArithmeticKeyCompatibility;
+    if (name == "valid_arithmetic_state_immutability") return &TestRelin2ValidArithmeticStateImmutability;
+    if (name == "tensor_validation_before_key") return &TestRelin2TensorValidationBeforeKey;
+    if (name == "insufficient_active_basis") return &TestRelin2InsufficientActiveBasis;
+    if (name == "missing_eval_key") return &TestRelin2MissingKey;
+    if (name == "key_empty") return &TestKeyEmpty;
+    if (name == "key_null_first") return &TestKeyNull;
+    if (name == "key_wrong_context") return &TestKeyWrongContext;
+    if (name == "key_wrong_tag") return &TestKeyWrongTag;
+    if (name == "key_wrong_subtype") return &TestKeyWrongSubtype;
+    if (name == "hybrid_a_length") return &TestHybridALength;
+    if (name == "hybrid_b_length") return &TestHybridBLength;
+    if (name == "hybrid_basis") return &TestHybridBasis;
+    if (name == "hybrid_format") return &TestHybridFormat;
+    if (name == "bv0_a_length") return &TestBv0ALength;
+    if (name == "bv0_b_length") return &TestBv0BLength;
+    if (name == "bv0_basis") return &TestBv0Basis;
+    if (name == "bv0_format") return &TestBv0Format;
+    if (name == "bvnz_a_length") return &TestBvNZALength;
+    if (name == "bvnz_b_length") return &TestBvNZBLength;
+    if (name == "bvnz_basis") return &TestBvNZBasis;
+    if (name == "bvnz_format") return &TestBvNZFormat;
+    if (name == "extra_later_valid") return &TestExtraValid;
+    if (name == "malformed_later_ignored") return &TestMalformedLater;
+    if (name == "bv0_valid_shapes") return &TestBv0ValidShapes;
+    if (name == "bvnz_valid_shapes") return &TestBvNZValidShapes;
+    if (name == "first_recombined_rcb_validation") return &TestFirstLifecycleRecombinedRcbValidation;
+    if (name == "first_recombined_tensor2_validation") return &TestFirstLifecycleRecombinedTensor2Validation;
+    if (name == "deterministic_dcp_boundary_witnesses") return &TestDeterministicDcpBoundaryWitnesses;
+    throw TestFailure("unknown Relin2 test case: " + name);
+}
