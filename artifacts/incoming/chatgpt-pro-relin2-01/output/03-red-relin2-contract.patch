+CryptoContext<DCRTPoly> MakeRelinContext(lbcrypto::KeySwitchTechnique technique = lbcrypto::HYBRID,
+                                         std::uint32_t digitSize = 0, std::uint32_t depth = 3) {
+    lbcrypto::CCParams<lbcrypto::CryptoContextCKKSRNS> parameters;
+    parameters.SetMultiplicativeDepth(depth);
+    parameters.SetScalingModSize(30);
+    parameters.SetFirstModSize(35);
+    parameters.SetScalingTechnique(lbcrypto::FIXEDMANUAL);
+    parameters.SetSecurityLevel(lbcrypto::HEStd_NotSet);
+    parameters.SetRingDim(32);
+    parameters.SetBatchSize(8);
+    parameters.SetKeySwitchTechnique(technique);
+    if (technique == lbcrypto::HYBRID) parameters.SetNumLargeDigits(2);
+    if (technique == lbcrypto::BV) parameters.SetDigitSize(digitSize);
+    auto context = lbcrypto::GenCryptoContext(parameters);
+    context->Enable(lbcrypto::PKE);
+    context->Enable(lbcrypto::KEYSWITCH);
+    context->Enable(lbcrypto::LEVELEDSHE);
+    return context;
+}
