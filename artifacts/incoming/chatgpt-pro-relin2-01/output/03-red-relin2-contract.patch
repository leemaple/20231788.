+enum class KeyMutation { Empty, NullFirst, WrongContext, WrongTag, WrongSubtype, ALength, BLength, Basis, Format,
+                         ExtraValid, MalformedLater };
+
+void RunKeyMutation(lbcrypto::KeySwitchTechnique technique, std::uint32_t digitSize, KeyMutation mutation,
+                    const std::string& expected, bool expectSuccess) {
+    EvalKeyMapGuard keyGuard;
+    auto fixture=MakeTensorFixtureFor(MakeRelinContext(technique,digitSize)); DoubleCKKS module(fixture.context);
+    auto [left,right]=MakePairs(fixture,module); auto tensor=module.Tensor2(left,right);
+    fixture.context->EvalMultKeyGen(fixture.keys.secretKey);
+    auto& map=lbcrypto::CryptoContextImpl<DCRTPoly>::GetAllEvalMultKeys();
+    const std::string tag=tensor.GetKeyTag();
+    Check(map.find(tag)!=map.end() && !map.at(tag).empty(), "fixture eval key missing");
+    auto valid=map.at(tag).front();
+    if (mutation==KeyMutation::Empty) map[tag].clear();
+    else if (mutation==KeyMutation::NullFirst) map[tag]={nullptr};
+    else if (mutation==KeyMutation::WrongContext) {
+        auto other=MakeRelinContext(technique,digitSize,4);
+        auto wrong=std::make_shared<lbcrypto::EvalKeyRelinImpl<DCRTPoly>>(other); wrong->SetKeyTag(tag);
+        auto base=CloneRelinKey(valid); wrong->SetAVector(base->GetAVector()); wrong->SetBVector(base->GetBVector()); map[tag]={wrong};
+    }
+    else if (mutation==KeyMutation::WrongTag) { auto k=CloneRelinKey(valid); k->SetKeyTag("wrong-tag"); map[tag]={k}; }
+    else if (mutation==KeyMutation::WrongSubtype) {
+        auto k=std::make_shared<lbcrypto::EvalKeyImpl<DCRTPoly>>(fixture.context); k->SetKeyTag(tag); map[tag]={k};
+    }
+    else if (mutation==KeyMutation::ExtraValid) map[tag]={valid,valid};
+    else if (mutation==KeyMutation::MalformedLater) map[tag]={valid,nullptr};
+    else {
+        auto k=CloneRelinKey(valid); auto a=k->GetAVector(); auto b=k->GetBVector();
+        if (mutation==KeyMutation::ALength) a.pop_back();
+        if (mutation==KeyMutation::BLength) b.pop_back();
+        if (mutation==KeyMutation::Basis) { auto bad=a.front(); bad.DropLastElement(); a.front()=std::move(bad); }
+        if (mutation==KeyMutation::Format) { auto bad=a.front(); bad.SetFormat(Format::COEFFICIENT); a.front()=std::move(bad); }
+        k->SetAVector(std::move(a)); k->SetBVector(std::move(b)); map[tag]={k};
+    }
+    const auto tensorBefore=SnapshotTensor(tensor,"malformed-key Tensor");
+    const auto mapBefore=SnapshotKeyMapShape();
+    if (expectSuccess) { const auto result=module.Relin2(tensor); Check(result.GetLifecycle()==PairLifecycle::ReadyForRS2,"extra-key Relin2 failed"); }
+    else CheckThrowsInvalidArgument([&]{ (void)module.Relin2(tensor); }, expected, "Relin2 malformed key");
+    CheckTensorUnchanged(tensor,tensorBefore,"malformed-key Tensor");
+    CheckKeyMapUnchanged(mapBefore,"Relin2 malformed-key case");
+}
