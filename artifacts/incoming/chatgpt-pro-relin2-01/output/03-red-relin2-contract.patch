+void CheckPublicRelinearizationShapes(const TensorCiphertextPair& tensor, const CryptoContext<DCRTPoly>& context) {
+    auto raised = RaiseHighReference(tensor, context);
+    lbcrypto::ConstCiphertext<DCRTPoly> raisedConst = raised;
+    auto high = context->Relinearize(raisedConst);
+    lbcrypto::ConstCiphertext<DCRTPoly> lowConst = tensor.GetLow();
+    auto low = context->Relinearize(lowConst);
+    Check(high->NumberCiphertextElements() == 2 && high->GetLevel() == 0,
+          "full-basis public Relinearize shape mismatch");
+    Check(low->NumberCiphertextElements() == 2 && low->GetLevel() == 1,
+          "level-one-prefix public Relinearize shape mismatch");
+}
+
+void CheckExactRelin2Oracle(const TensorCiphertextPair& tensor, const CiphertextPair& actual,
+                            const CryptoContext<DCRTPoly>& context) {
+    auto raised = RaiseHighReference(tensor, context);
+    lbcrypto::ConstCiphertext<DCRTPoly> raisedConst = raised;
+    auto relinRaised = context->Relinearize(raisedConst);
+    lbcrypto::ConstCiphertext<DCRTPoly> lowConst = tensor.GetLow();
+    auto relinLow = context->Relinearize(lowConst);
+    const BigInt divisor(tensor.GetDivisor().ConvertToInt());
+    const std::size_t n = raised->GetElements().front().GetParams()->GetRingDimension();
+    bool keySwitchWitness = false;
+    bool remainderLowWitness = false;
+    std::string keySwitchName;
+    std::string remainderLowName;
+    for (std::size_t component = 0; component < 2; ++component) {
+        auto k = relinRaised->GetElements()[component] - raised->GetElements()[component];
+        auto kc = ToCoefficient(k);
+        for (std::size_t tower=0; tower<kc.GetAllElements().size() && !keySwitchWitness; ++tower) {
+            for (std::size_t coefficient=0; coefficient<n; ++coefficient) {
+                if (CoefficientResidue(kc,tower,coefficient) != 0) {
+                    keySwitchWitness = true;
+                    keySwitchName = "component="+std::to_string(component)+",tower="+std::to_string(tower)+",coefficient="+std::to_string(coefficient);
+                    break;
+                }
+            }
+        }
+        const auto actualHigh = ToCoefficient(actual.GetHigh()->GetElements()[component]);
+        const auto actualLow = ToCoefficient(actual.GetLow()->GetElements()[component]);
+        const auto w = ToCoefficient(relinLow->GetElements()[component]);
+        const auto prefixModuli = GetModuli(actualHigh);
+        for (std::size_t coefficient = 0; coefficient < n; ++coefficient) {
+            const BigInt source = ReconstructCoefficient(relinRaised->GetElements()[component], coefficient);
+            const auto [quotient, remainder] = DecomposeCentered(source, divisor);
+            for (std::size_t tower=0; tower<prefixModuli.size(); ++tower) {
+                const BigInt wResidue = CoefficientResidue(w,tower,coefficient);
+                Check(CoefficientResidue(actualHigh,tower,coefficient) == PositiveMod(quotient,prefixModuli[tower]),
+                      "Relin2 quotient oracle mismatch");
+                Check(CoefficientResidue(actualLow,tower,coefficient) == PositiveMod(remainder+wResidue,prefixModuli[tower]),
+                      "Relin2 v+w oracle mismatch");
+                if (!remainderLowWitness && PositiveMod(remainder,prefixModuli[tower]) != 0 && wResidue != 0) {
+                    remainderLowWitness = true;
+                    remainderLowName = "component="+std::to_string(component)+",tower="+std::to_string(tower)+",coefficient="+std::to_string(coefficient);
+                }
+            }
+        }
+    }
+    Check(keySwitchWitness, "Relin2 fixture failed to produce a nonzero K0/K1 key-switch contribution");
+    Check(remainderLowWitness, "Relin2 fixture failed to produce a common nonzero v/w position");
+    std::cout << "Relin2 K witness: " << keySwitchName << '\n';
+    std::cout << "Relin2 v/w witness: " << remainderLowName << '\n';
+
+    const auto recombined = actual.GetHigh()->Clone();
+    auto& recombinedElements = recombined->GetElements();
+    const auto& actualLowElements = actual.GetLow()->GetElements();
+    for (std::size_t i=0;i<recombinedElements.size();++i) {
+        recombinedElements[i] *= tensor.GetDivisor();
+        recombinedElements[i] += actualLowElements[i];
+    }
+    for (std::size_t component=0; component<2; ++component) {
+        const auto rc = ToCoefficient(recombined->GetElements()[component]);
+        const auto w = ToCoefficient(relinLow->GetElements()[component]);
+        const auto moduli = GetModuli(rc);
+        for (std::size_t coefficient=0; coefficient<n; ++coefficient) {
+            const BigInt source = ReconstructCoefficient(relinRaised->GetElements()[component], coefficient);
+            for (std::size_t tower=0;tower<moduli.size();++tower) {
+                Check(CoefficientResidue(rc,tower,coefficient) ==
+                          PositiveMod(source + CoefficientResidue(w,tower,coefficient), moduli[tower]),
+                      "Relin2 RCB identity mismatch");
+            }
+        }
+    }
+}
