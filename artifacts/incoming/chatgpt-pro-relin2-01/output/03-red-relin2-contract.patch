+TensorFixture MakeTensorFixtureFor(const CryptoContext<DCRTPoly>& context) {
+    TensorFixture fixture;
+    fixture.context = context;
+    fixture.keys = fixture.context->KeyGen();
+    auto plaintext = fixture.context->MakeCKKSPackedPlaintext(std::vector<double>{0.0}, 2, 0);
+    fixture.leftInput = fixture.context->Encrypt(plaintext, fixture.keys.publicKey);
+    fixture.rightInput = fixture.context->Encrypt(plaintext, fixture.keys.publicKey);
+    const auto params = fixture.leftInput->GetElements().front().GetParams();
+    const std::size_t n = params->GetRingDimension();
+    const auto fullModuli = GetModuli(fixture.leftInput->GetElements().front());
+    Check(fullModuli.size() >= 3, "Relin2 fixture requires at least three full-basis towers");
+    const BigInt divisor = fullModuli.back();
+    std::vector<BigInt> lh0(n,0), ll0(n,0), lh1(n,0), ll1(n,0), rh0(n,0), rl0(n,0), rh1(n,0), rl1(n,0);
+    lh0[n-1] = 1; rh0[1] = 1;
+    lh1[0] = -1000003; rh1[0] = 1000033;
+    ll0[2] = 17; rl0[3] = -19; ll1[4] = -23; rl1[5] = 29;
+    fixture.leftInput->SetElements({MakePolynomial(params, ComposeSource(divisor, lh0, ll0)),
+                                    MakePolynomial(params, ComposeSource(divisor, lh1, ll1))});
+    fixture.rightInput->SetElements({MakePolynomial(params, ComposeSource(divisor, rh0, rl0)),
+                                     MakePolynomial(params, ComposeSource(divisor, rh1, rl1))});
+    return fixture;
+}
