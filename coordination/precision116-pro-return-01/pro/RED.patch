+        // it does not run another encrypted multiplication.
+        const openfhe_2023_1788::DoubleCKKS stillUsable(diagnostic.plan);
+        (void)stillUsable;
+    }
+    CheckReleased(diagnosticOwners);
+    Require(CurrentRows() == initialRows &&
+            lbcrypto::CryptoContextImpl<Poly>::GetAllEvalAutomorphismKeys() == initialAutomorphisms,
+            "global evaluation-key cache ownership restored");
