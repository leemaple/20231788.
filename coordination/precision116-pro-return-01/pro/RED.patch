+    Require(result.GetHigh() != pair.GetHigh() && result.GetLow() != pair.GetLow() &&
+            result.GetHigh()->GetMetadataMap() != pair.GetHigh()->GetMetadataMap() &&
+            result.GetLow()->GetMetadataMap() != pair.GetLow()->GetMetadataMap(), "new family snapshot ownership");
