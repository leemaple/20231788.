+        std::vector<SmallRow> smallRows;
+        for (std::size_t f = 0; f < diagnostic.plan->GetFamilyCount(); ++f) {
+            const auto& tag = diagnostic.plan->GetFamilyKeyTag(f);
+            const auto& key = lbcrypto::CryptoContextImpl<Poly>::GetAllEvalMultKeys().at(tag)[0];
+            smallRows.push_back({tag, key, key->GetAVector(), key->GetBVector()});  // Small N64 guard only.
