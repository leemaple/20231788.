+    // rather than copying every large evaluation row into this test.
+    const auto preservedFresh = fresh.CloneForEvaluation();
+    Require(preservedFresh.get() != input.get() && preservedFresh->GetMetadataMap() != input->GetMetadataMap() &&
+            preservedFresh->GetElements() == inputSnapshot->GetElements(), "fresh owner preserved independently");
+    Require(setup.publicKey.get() == publicIdentity && setup.rootSecret.get() == secretIdentity &&
+            setup.publicKey->GetPublicElements() == publicSnapshot && setup.rootSecret->GetPrivateElement() == secretSnapshot &&
