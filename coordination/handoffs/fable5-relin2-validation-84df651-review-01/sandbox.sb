(version 1)
(allow default)

(deny file-read*)
(deny file-write*)

(deny mach-lookup
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.securityd")
  (global-name "com.apple.securityd.aps")
  (global-name "com.apple.securityd.ckks")
  (global-name "com.apple.securityd.general")
  (global-name "com.apple.securityd.sos")
  (global-name "com.apple.securityd.systemkeychain")
  (global-name "com.apple.securityd.xpc"))

(allow file-read*
  (literal "/")
  (literal "/private")
  (literal "/private/var")
  (literal "/private/var/run")
  (literal "/private/var/tmp")
  (literal "/private/var/tmp/fable5-relin2-84df651.ZLu6Uh")
  (literal "/Users")
  (literal "/Users/lifeng")
  (literal "/Users/lifeng/.local")
  (literal "/Users/lifeng/.local/share")
  (literal "/Users/lifeng/.local/share/claude")
  (literal "/Users/lifeng/.local/share/claude/versions")
  (literal "/Users/lifeng/Documents")
  (literal "/Users/lifeng/Documents/20231788-openfhe-cleanroom-20260831")
  (literal "/Users/lifeng/Documents/20231788-openfhe-cleanroom-20260831/coordination")
  (literal "/Users/lifeng/Documents/20231788-openfhe-cleanroom-20260831/coordination/tasks")
  (subpath "/System")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/dev")
  (literal "/private/etc")
  (literal "/private/etc/hosts")
  (literal "/private/etc/resolv.conf")
  (literal "/private/etc/ssl")
  (literal "/private/etc/ssl/cert.pem")
  (literal "/private/var/run/resolv.conf")
  (literal "/Users/lifeng/.local/share/claude/versions/2.1.239")
  (subpath "/private/var/tmp/fable5-relin2-84df651.ZLu6Uh/claude-tmp")
  (subpath "/private/var/tmp/fable5-relin2-84df651.ZLu6Uh/fresh-extraction")
  (literal "/Users/lifeng/Documents/20231788-openfhe-cleanroom-20260831/coordination/tasks/fable5-relin2-validation-84df651-review-01.md"))

(deny file-read*
  (subpath "/System/Volumes/Data"))

(allow file-write*
  (subpath "/private/var/tmp/fable5-relin2-84df651.ZLu6Uh/claude-tmp")
  (subpath "/private/var/tmp/fable5-relin2-84df651.ZLu6Uh/claude-home")
  (literal "/dev/null"))
